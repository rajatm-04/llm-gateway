# LLM Providers
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.experientiallabs.ai/v1/
OPENAI_MODEL=gpt-5.6-sol
# Set GEMINI_API_KEY when using GeminiProvider in providers/registry.py.
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi4-mini
OLLAMA_TIMEOUT=120

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cache Settings
CACHE_SIMILARITY_THRESHOLD=0.95

# Optional custom JSON profile; use an absolute path outside the project root.
# ROUTING_PROFILE_PATH=/absolute/path/to/model-profile.json
LOCAL_MAX_INPUT_BYTES=12000
PREMIUM_MAX_INPUT_BYTES=120000
LOCAL_MAX_OUTPUT_TOKENS=2048
PREMIUM_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT=120